{
  "name": "demo-webshop-playwright",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "allure-playwright": "^2.0.0",
    "allure-commandline": "^2.13.9"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report:html": "playwright show-report reports/html-report || true",
    "report:allure:generate": "npx allure generate reports/allure-results -o reports/allure-report --clean || true",
    "report:allure:open": "npx allure open reports/allure-report || true",
    "report:allure:serve": "npx allure serve reports/allure-results || true"
  }
}
